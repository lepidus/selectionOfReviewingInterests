msgid "plugins.generic.selectionOfReviewingInterests.displayName"
msgstr "Intereses de revisión predefinidos"

msgid "plugins.generic.selectionOfReviewingInterests.description"
msgstr "Permite definir, en la configuración del plugin, las opciones de intereses de revisión que los revisores podrán elegir. Estos usuarios solo pueden seleccionar las opciones predefinidas y, si no tienen ningún área registrada, son redirigidos automáticamente a la página de edición de perfil cada vez que intentan acceder al panel de OJS, hasta que definan al menos un área de interés."

msgid "plugins.generic.selectionOfReviewingInterests.profilePage.emptyInterestsMessage"
msgstr "Debe seleccionar al menos un interés de revisión en la pestaña \"Roles\" antes de poder acceder al sistema."

msgid "plugins.generic.selectionOfReviewingInterests.profilePage.placeholder"
msgstr "Seleccione una o más opciones"

msgid "plugins.generic.selectionOfReviewingInterests.profilePage.invalidInterest"
msgstr "Seleccione únicamente los intereses de revisión predefinidos. Los intereses guardados anteriormente se pueden conservar o eliminar."

msgid "plugins.generic.selectionOfReviewingInterests.configuration.description"
msgstr "Defina las opciones de interés de revisión disponibles para los revisores. Estas opciones reemplazan el campo de texto libre de intereses en el perfil del usuario. Los revisores solo podrán seleccionar entre las opciones listadas a continuación. Los revisores que no hayan seleccionado al menos un interés serán redirigidos a su página de perfil al iniciar sesión."

msgid "plugins.generic.selectionOfReviewingInterests.configuration.grid.title"
msgstr "Opciones de Interés de Revisión"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.grid.column.option"
msgstr "Opción de interés"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.addOption"
msgstr "Añadir opción"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.form.optionText"
msgstr "Texto de la opción"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.form.optionText.description"
msgstr "Ingrese el texto que aparecerá como una opción de interés de revisión seleccionable para los revisores en su perfil."

msgid "plugins.generic.selectionOfReviewingInterests.configuration.form.optionText.required"
msgstr "El texto de la opción es obligatorio."

msgid "plugins.generic.selectionOfReviewingInterests.reviewer.filter.label"
msgstr "Filtrar por intereses de revisión"
