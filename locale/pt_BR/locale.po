msgid "plugins.generic.selectionOfReviewingInterests.displayName"
msgstr "Áreas de interesse predefinidas"

msgid "plugins.generic.selectionOfReviewingInterests.description"
msgstr "Permite definir, nas configurações do plugin, as opções de Áreas de Interesse para Avaliação que poderão ser escolhidas pelos avaliadores. Esses usuários podem selecionar apenas as opções predefinidas e, caso não tenham nenhuma área cadastrada, são automaticamente redirecionados para a página de edição de perfil sempre que tentarem acessar o painel do OJS, até que definam ao menos uma área de interesse."

msgid "plugins.generic.selectionOfReviewingInterests.profilePage.emptyInterestsMessage"
msgstr "É necessário selecionar pelo menos uma área de interesse para avaliação na aba \"Papéis\" antes de acessar o sistema."

msgid "plugins.generic.selectionOfReviewingInterests.profilePage.placeholder"
msgstr "Selecione uma ou mais opções"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.description"
msgstr "Defina as opções de interesse de avaliação disponíveis para os avaliadores. Essas opções substituem o campo de texto livre de interesses no perfil do usuário. Os avaliadores só poderão selecionar entre as opções listadas abaixo. Avaliadores que não tiverem selecionado pelo menos um interesse serão redirecionados para a página de perfil ao fazer login."

msgid "plugins.generic.selectionOfReviewingInterests.configuration.grid.title"
msgstr "Opções de Interesse de Avaliação"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.grid.column.option"
msgstr "Opção de interesse"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.addOption"
msgstr "Adicionar opção"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.form.optionText"
msgstr "Texto da opção"

msgid "plugins.generic.selectionOfReviewingInterests.configuration.form.optionText.description"
msgstr "Insira o texto que aparecerá como uma opção de interesse de avaliação selecionável para os avaliadores em seu perfil."

msgid "plugins.generic.selectionOfReviewingInterests.configuration.form.optionText.required"
msgstr "O texto da opção é obrigatório."

msgid "plugins.generic.selectionOfReviewingInterests.reviewer.filter.label"
msgstr "Filtrar por áreas de interesse"
